
Функция ПолучитьКаталогНоменклатуры(Запрос) 
    // 1. Инициализируем HTTP-ответ с кодом 200 (ОК)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // 2. Пишем SQL-подобный запрос к справочнику Номенклатуры УТ
    Запрос1С = Новый Запрос;
    Запрос1С.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 50
        |	Номенклатура.Ссылка КАК id,
        |	Номенклатура.Наименование КАК name,
        |	Номенклатура.Артикул КАК article
        |ИЗ
        |	Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |	НЕ Номенклатура.ЭтоГруппа"; // Выбираем штучные товары, игнорируя папки
        
    Выборка = Запрос1С.Выполнить().Выбрать();
    
    // 3. Собираем массив структур (в JS это массив объектов)
    МассивТоваров = Новый Массив;
    Пока Выборка.Следующий() Цикл
        ТоварОбъект = Новый Структура;
        // Превращаем внутреннюю ссылку 1С в стандартную Guid-строку для веба
        ТоварОбъект.Вставить("id", Строка(Выборка.id.УникальныйИдентификатор())); 
        ТоварОбъект.Вставить("name", Выборка.name);
        ТоварОбъект.Вставить("article", Выборка.article);
        
        МассивТоваров.Добавить(ТоварОбъект);
    КонецЦикла;
    
    // 4. Сериализация в JSON-строку (аналог JSON.stringify)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивТоваров);
    
    JSONСтрока = ЗаписьJSON.Закрыть();
    
    // 5. Кладем JSON в тело ответа и возвращаем клиенту
    Ответ.УстановитьТелоИзСтроки(JSONСтрока);
    Возврат Ответ;
    
КонецФункции


Функция ОпубликоватьЗаказВКаталоге(Запрос)
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    
    // 1. Парсим входящий JSON в структуру/соответствие 1С
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеЗаказа = ПрочитатьJSON(ЧтениеJSON, Истина); // Истина = читать в Соответствие (Map)
        ЧтениеJSON.Закрыть();
    Исключение
        Ответ.КодСостояния = 400; // Bad Request
        Ответ.УстановитьТелоИзСтроки("{""error"": ""Некорректный формат JSON""}");
        Возврат Ответ;
    КонецПопытки;
    
    // 2. Создаем и заполняем документ "Заказ клиента" в УТ
    Попытка
        НовыйЗаказ = Документы.ЗаказКлиента.СоздатьДокумент();
        НовыйЗаказ.Дата = ТекущаяДатаСеанса();
        НовыйЗаказ.Комментарий = ДанныеЗаказа.Получить("comment");
        
        // Находим ссылку на клиента по переданному UUID
        УИДКлиента = Новый УникальныйИдентификатор(ДанныеЗаказа.Получить("clientId"));
        НовыйЗаказ.Партнер = Справочники.Партнеры.ПолучитьСсылку(УИДКлиента);
        
        // Заполняем табличную часть "Товары"
        МассивТоваров = ДанныеЗаказа.Получить("items");
        Для Каждого СтрокаJSON Из МассивТоваров Цикл
            НоваяСтрока = НовыйЗаказ.Товары.Add();
            
            УИДТовара = Новый УникальныйИдентификатор(СтрокаJSON.Получить("localId"));
            НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИДТовара);
            НоваяСтрока.Количество = СтрокаJSON.Получить("quantity");
            НоваяСтрока.Цена = СтрокаJSON.Получить("price");
            НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
        КонецЦикла;
        
        // Записываем документ
        НовыйЗаказ.Записать(РежимЗаписиДокумента.Запись);
        
        // 3. Возвращаем клиенту ID созданного документа и его номер в 1С
        Результат = Новый Структура;
        Результат.Вставить("status", "created");
        Результат.Вставить("orderId", Строка(НовыйЗаказ.Ссылка.УникальныйИдентификатор()));
        Результат.Вставить("orderNumber", НовыйЗаказ.Номер);
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Результат);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        
    Исключение
        Ответ.КодСостояния = 500;
        ТекстОшибки = ОписаниеОшибки();
        Ответ.УстановитьТелоИзСтроки("{""error"": """ + СтрЗаменить(ТекстОшибки, """", "'") + """}");
    КонецПопытки;
    
    Возврат Ответ;
    
КонецФункции
