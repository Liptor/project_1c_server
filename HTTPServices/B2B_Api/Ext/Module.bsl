Функция ПолучитьКаталогНоменклатуры(Запрос)     // 1. Инициализируем HTTP-ответ с кодом 200 (ОК)    Ответ = Новый HTTPСервисОтвет(200);    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");        // 2. Пишем SQL-подобный запрос к справочнику Номенклатуры УТ    Запрос1С = Новый Запрос;    Запрос1С.Текст =         "ВЫБРАТЬ ПЕРВЫЕ 50        |	Номенклатура.Ссылка КАК id,        |	Номенклатура.Наименование КАК name,        |	Номенклатура.Код КАК code        |ИЗ        |	Справочник.Номенклатура КАК Номенклатура        |ГДЕ        |	НЕ Номенклатура.ЭтоГруппа"; // Выбираем штучные товары, игнорируя папки            Выборка = Запрос1С.Выполнить().Выбрать();        // 3. Собираем массив структур (в JS это массив объектов)    МассивТоваров = Новый Массив;    Пока Выборка.Следующий() Цикл        ТоварОбъект = Новый Структура;        // Превращаем внутреннюю ссылку 1С в стандартную Guid-строку для веба        ТоварОбъект.Вставить("id", Строка(Выборка.id.УникальныйИдентификатор()));         ТоварОбъект.Вставить("name", Выборка.name);        ТоварОбъект.Вставить("code", Выборка.code);                МассивТоваров.Добавить(ТоварОбъект);    КонецЦикла;        // 4. Сериализация в JSON-строку (аналог JSON.stringify)    ЗаписьJSON = Новый ЗаписьJSON;    ЗаписьJSON.УстановитьСтроку();    ЗаписатьJSON(ЗаписьJSON, МассивТоваров);        JSONСтрока = ЗаписьJSON.Закрыть();        // 5. Запихиваем JSON в тело ответа и возвращаем клиенту    Ответ.УстановитьТелоИзСтроки(JSONСтрока);    Возврат Ответ;    КонецФункции